# Triton One / rpcpool endpoints stay server-side.
# Use your tokenized HTTPS URLs here; never put them in web/src or committed config.
TRITON_DEFAULT_CLUSTER=devnet
TRITON_DEVNET_RPC_URL=https://xfsoluti-solanad-d155.devnet.rpcpool.com/<x-token>
TRITON_MAINNET_RPC_URL=https://xfsoluti-solanam-739d.mainnet.rpcpool.com/<x-token>
TRITON_DEVNET_FALLBACK_RPC_URL=
TRITON_MAINNET_FALLBACK_RPC_URL=

# Optional Dragon's Mouth gRPC endpoints. Used for capability display today;
# future live signature streaming can opt in when configured.
TRITON_DEVNET_GRPC_URL=
TRITON_MAINNET_GRPC_URL=

# Optional fixed token. If omitted, the Axum server generates one at startup.
RAYDIUM_DEBUGGER_API_TOKEN=
RAYDIUM_DEBUGGER_MAX_CONCURRENT_DEBUGS=4

# Publish reviewed, sanitized incidents here. Runtime AI never reads the support database.
# This path must match the support-knowledge compile output.
RAYDIUM_DEBUGGER_KNOWLEDGE_PATH=.raydium-debugger/knowledge/incidents.generated.json
# Private archive review in the local UI. These paths are never sent to runtime AI.
RAYDIUM_DEBUGGER_SUPPORT_DATABASE_PATH=.raydium-debugger/support-knowledge.sqlite
RAYDIUM_DEBUGGER_REVIEW_PACKETS_PATH=.raydium-debugger/ai-case-reviews/packets.jsonl
RAYDIUM_DEBUGGER_REVIEW_DRAFTS_PATH=.raydium-debugger/ai-case-reviews/drafts.jsonl
RAYDIUM_DEBUGGER_CHAT_EXPORT_PATH=.raydium-debugger/ChatExport_2026-09-28
# Public upgrade notices compiled from the private archive and pinned references.
RAYDIUM_DEBUGGER_UPDATES_PATH=.raydium-debugger/knowledge/updates.generated.json
# Build the CLI/server/desktop with --features ai and configure your provider credentials.
# Set this to a model supported by the configured genai provider.
RAYDIUM_DEBUGGER_AI_MODEL=
