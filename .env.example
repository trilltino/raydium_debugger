# Triton One / rpcpool endpoints stay server-side.
# Use your tokenized HTTPS URLs here; never put them in web/src or committed config.
TRITON_DEFAULT_CLUSTER=devnet
TRITON_DEVNET_RPC_URL=https://xfsoluti-solanad-d155.devnet.rpcpool.com/<x-token>
TRITON_MAINNET_RPC_URL=https://xfsoluti-solanam-739d.mainnet.rpcpool.com/<x-token>
TRITON_DEVNET_FALLBACK_RPC_URL=
TRITON_MAINNET_FALLBACK_RPC_URL=

# Optional Dragon's Mouth gRPC endpoints. Used for capability display today;
# future live signature streaming can opt in when configured.
TRITON_DEVNET_GRPC_URL=
TRITON_MAINNET_GRPC_URL=

# Optional fixed token. If omitted, the Axum server generates one at startup.
RAYDIUM_DEBUGGER_API_TOKEN=
RAYDIUM_DEBUGGER_MAX_CONCURRENT_DEBUGS=4
