{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raydium Debugger",
  "version": "0.1.0",
  "identifier": "com.trilltino.raydium-debugger",
  "build": {
    "beforeDevCommand": {
      "cwd": "../web",
      "script": "npm run dev",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "../web",
      "script": "npm run build",
      "wait": true
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raydium Debugger",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8787 http://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
